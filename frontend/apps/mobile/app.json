{
  "expo": {
    "name": "support-me-system",
    "slug": "support-me-system",
    "scheme": "supportme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supportmesystem.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.supportmesystem.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7a2d4057-cada-47cc-8539-618063f648ea"
      }
    },
    "owner": "marcin-lula-support-me"
  }
}
