{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@support-me/ui": ["packages/ui/src/index.ts"],
      "@support-me/ui/*": ["packages/ui/src/*"],
      "@support-me/app": ["packages/app/src/index.ts"],
      "@support-me/app/*": ["packages/app/src/*"],
      "@support-me/api-client": ["packages/api-client/src/index.ts"],
      "@support-me/api-client/*": ["packages/api-client/src/*"],
      "@support-me/auth": ["packages/auth/src/index.ts"],
      "@support-me/auth/*": ["packages/auth/src/*"],
      "@support-me/config/*": ["packages/config/*"]
    }
  },
  "exclude": ["node_modules"]
}
